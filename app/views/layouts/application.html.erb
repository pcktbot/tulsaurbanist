<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8">
    <title><%= content_for?(:title) ? yield(:title) : "Tulsa Urbanist — Mapping the human cost of car-first streets" %></title>
    <meta name="description" content="<%= content_for?(:description) ? yield(:description) : "An open map of Tulsa: traffic deaths, surface parking, and the value every acre returns. See how much we leave on the table — and redesigns that ask more of our land." %>">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="robots" content="index, follow, max-image-preview:large">
    <link rel="canonical" href="<%= content_for?(:canonical) ? yield(:canonical) : request.url %>">
    <meta property="og:type" content="<%= content_for?(:og_type) ? yield(:og_type) : "website" %>">
    <meta property="og:site_name" content="Tulsa Urbanist">
    <meta property="og:title" content="<%= content_for?(:og_title) ? yield(:og_title) : (content_for?(:title) ? yield(:title) : "Tulsa Urbanist — Mapping the human cost of car-first streets") %>">
    <meta property="og:description" content="<%= content_for?(:og_description) ? yield(:og_description) : (content_for?(:description) ? yield(:description) : "How much value does each acre return? Traffic deaths, parking, and redesigns on one map of Tulsa.") %>">
    <meta property="og:url" content="<%= content_for?(:canonical) ? yield(:canonical) : request.url %>">
    <meta property="og:image" content="<%= content_for?(:og_image) ? yield(:og_image) : "https://tulsaurbanist.org/og/tulsa-urbanist-map.png" %>">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= content_for?(:og_title) ? yield(:og_title) : (content_for?(:title) ? yield(:title) : "Tulsa Urbanist — Mapping the human cost of car-first streets") %>">
    <meta name="twitter:description" content="<%= content_for?(:og_description) ? yield(:og_description) : (content_for?(:description) ? yield(:description) : "How much value does each acre return? Traffic deaths, parking, and redesigns on one map of Tulsa.") %>">
    <%= yield :json_ld %>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= render 'layouts/fonts' %>
    <%= stylesheet_link_tag 'application', 'data-turbo-track': 'reload' %>
    <%= javascript_pack_tag 'application', 'data-turbo-track': 'reload' %>
    <%= yield :head %>
  </head>

  <body class="<%= controller_name %>-controller">
    <% if notice.present? || alert.present? %>
      <div class="flash-messages">
        <% if notice %>
          <p class="notice"><%= notice %></p>
        <% end %>
        <% if alert %>
          <p class="alert"><%= alert %></p>
        <% end %>
      </div>
    <% end %>

    <div class="main">
      <%= yield %>
    </div>
  </body>
</html>
