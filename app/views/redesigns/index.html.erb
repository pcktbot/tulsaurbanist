<%= render 'shared/header' do %>
  <% if user_authenticated? %>
    <%= link_to 'New redesign', new_redesign_path, class: 'link' %>
  <% end %>
<% end %>

<div class="rds-page">
  <div class="rds-page-header">
    <h1 class="rds-page-title">Citizen <span>Redesigns</span></h1>
    <% if user_authenticated? %>
      <%= link_to 'New redesign', new_redesign_path, class: 'rds-new-link' %>
    <% end %>
  </div>

  <% if @redesigns.any? %>
    <div class="rds-grid">
      <% @redesigns.each do |redesign| %>
        <div class="rds-card">
          <div class="rds-card-name"><%= link_to redesign.name, redesign %></div>
          <% if redesign.description.present? %>
            <p class="rds-card-desc"><%= redesign.description %></p>
          <% end %>
          <div class="rds-card-meta">Updated <%= time_ago_in_words(redesign.updated_at) %> ago</div>
          <div class="rds-card-actions">
            <%= link_to 'Open', redesign, class: 'rds-action-link' %>
            <% if user_authenticated? %>
              <%= link_to 'Edit', edit_redesign_path(redesign), class: 'rds-action-link' %>
              <%= button_to 'Delete', redesign, method: :delete, data: { confirm: 'Are you sure?' }, class: 'rds-action-link destructive' %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="rds-empty">No redesigns yet.</p>
  <% end %>
</div>
