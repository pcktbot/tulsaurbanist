<% content_for :head do %>
  <meta name="mapbox-token" content="<%= ENV['MAPBOX_ACCESS_TOKEN'] %>">
  <link href="https://api.mapbox.com/mapbox-gl-js/v3.11.0/mapbox-gl.css" rel="stylesheet">
<% end %>

<%= render 'shared/header' do %>
  <%= link_to 'All redesigns', redesigns_path, class: 'link' %>
<% end %>

<div class="rds-form" data-controller="location-picker">
  <h1 class="rds-form-title">New Redesign</h1>

  <%= form_with(model: @redesign, local: true) do |f| %>
    <% if @redesign.errors.any? %>
      <div class="error-messages">
        <h3><%= pluralize(@redesign.errors.count, "error") %> prohibited this redesign from being saved:</h3>
        <ul>
          <% @redesign.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="field">
      <%= f.label :name %>
      <%= f.text_field :name, required: true %>
    </div>

    <div class="field">
      <%= f.label :description %>
      <%= f.text_area :description, rows: 4 %>
    </div>

    <div class="location-picker-section">
      <h3>Select Location</h3>
      <p class="help-text">Drag the red marker to set the center of your redesign area</p>
      <div class="location-picker-map" data-location-picker-target="map"></div>
      <div class="location-inputs">
        <div class="field">
          <%= f.label :center_latitude %>
          <%= f.number_field :center_latitude, step: :any, required: true,
                             data: { location_picker_target: "latInput" },
                             value: 36.1539 %>
        </div>
        <div class="field">
          <%= f.label :center_longitude %>
          <%= f.number_field :center_longitude, step: :any, required: true,
                             data: { location_picker_target: "lngInput" },
                             value: -95.9928 %>
        </div>
        <div class="field">
          <%= f.label :max_radius, "Max radius (m)" %>
          <%= f.number_field :max_radius, step: :any, required: true,
                             data: { location_picker_target: "radiusInput" },
                             value: 500 %>
        </div>
      </div>
    </div>

    <div class="actions">
      <%= f.submit "Create redesign" %>
      <%= link_to "Cancel", redesigns_path, class: "btn" %>
    </div>
  <% end %>
</div>
