<div class="">
<%= render 'shared/header' do %>
  <div class="links align-stretch">
    <%= link_to 'New Incident', new_incident_path, class: 'link' %>
  </div>
<% end %>

<div class="notice hidden"><%= notice %></div>


<div class="incidents-container">
  <div class="incidents-header">
    <div class="incident-col date-col">Date</div>
    <div class="incident-col location-col">Location</div>
    <div class="incident-col description-col">Description</div>
    <div class="incident-col fatalities-col">Fatalities</div>
    <div class="incident-col actions-col">Actions</div>
  </div>
  <div class="incidents-list">
    <% @incidents.each do |incident| %>
      <div class="incident-row">
        <div class="incident-col date-col"><%= incident.date_time.strftime("%B %d, %Y") %></div>
        <div class="incident-col location-col"><%= incident.location_description %></div>
        <div class="incident-col description-col"><%= incident.brief_description %></div>
        <div class="incident-col fatalities-col"><%= incident.fatality_count %></div>
        <div class="incident-col actions-col">
          <div class="action-group">
            <div class="action-item">
              <%= link_to 'Show', incident, class: 'action' %>
            </div>
            <div class="action-item">
              <%= link_to 'Edit', edit_incident_path(incident), class: 'action' %>
            </div>
            <div class="action-item">
              <%= link_to 'Delete', incident, method: :delete, data: { confirm: 'Are you sure?' }, class: 'action destructive' %>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>
</div>