<h1>Incidents</h1>

<div class="notice hidden"><%= notice %></div>

<div class="actions">
  <%= link_to 'New Incident', new_incident_path, class: 'button' %>
</div>

<table class="table">
  <thead>
    <tr>
      <th class="left">Date</th>
      <th class="left">Location</th>
      <th class="right">Fatalities</th>
      <th class="left">Verification</th>
      <th class="center">Actions</th>
    </tr>
  </thead>
  <tbody>
    <% @incidents.each do |incident| %>
      <tr>
        <td><%= incident.date_time.strftime("%B %d, %Y") %></td>
        <td><%= incident.location_description %></td>
        <td class="right"><%= incident.fatality_count %></td>
        <td><%= incident.verification_status_display %></td>        
        <td class="actions">
          <%= link_to 'Show', incident, class: 'button control' %>
          <%= link_to 'Edit', edit_incident_path(incident), class: 'button control' %>
          <%= link_to 'Delete', incident, method: :delete, data: { confirm: 'Are you sure?' }, class: 'button control destructive' %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
