<%= render 'shared/header' do %>
  <%= link_to 'All incidents', incidents_path, class: 'link' %>
  <% if user_authenticated? %>
    <%= link_to 'Edit', edit_incident_path(@incident), class: 'link' %>
    <%= link_to 'Delete', incident_path(@incident), method: :delete, data: { confirm: 'Are you sure?' }, class: 'link' %>
  <% end %>
<% end %>

<div class="inc-show">
  <div class="inc-show-header">
    <div class="inc-show-date"><%= @incident.date_time.strftime("%B %d, %Y · %I:%M %p").upcase %></div>
    <div class="inc-show-location"><%= @incident.location_description %></div>
    <div class="inc-show-fatalities">
      <span class="inc-show-fatality-num"><%= @incident.fatality_count %></span>
      <span class="inc-show-fatality-label"><%= @incident.fatality_count == 1 ? 'fatality' : 'fatalities' %></span>
    </div>
  </div>

  <dl class="inc-show-dl">
    <% if @incident.brief_description.present? %>
      <dt>Description</dt>
      <dd><%= @incident.brief_description %></dd>
    <% end %>

    <% if @incident.total_fatalities_by_type.any? { |_, count| count > 0 } %>
      <dt>By type</dt>
      <dd>
        <ul>
          <% @incident.total_fatalities_by_type.each do |type, count| %>
            <% if count > 0 %>
              <li><%= type.to_s.humanize %>: <%= count %></li>
            <% end %>
          <% end %>
        </ul>
      </dd>
    <% end %>

    <dt>Source</dt>
    <dd><%= @incident.information_source %></dd>

    <dt>Reference</dt>
    <dd><%= @incident.source&.name || '—' %></dd>

    <dt>Verification</dt>
    <dd><%= @incident.verification_status_display %></dd>

    <% if @incident.has_geo_coordinates? %>
      <dt>Coordinates</dt>
      <dd><%= @incident.latitude %>, <%= @incident.longitude %></dd>
    <% end %>
  </dl>
</div>
