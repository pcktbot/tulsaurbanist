<% content_for :title, "Tulsa Urbanist — Mapping the human cost of car-first streets" %>
<% content_for :description, "An open map of Tulsa: traffic deaths, surface parking, and the value every acre returns. See how much we leave on the table — and redesigns that ask more of our land." %>
<% content_for :og_description, "How much value does each acre return? Traffic deaths, parking, and redesigns on one map of Tulsa." %>
<% content_for :canonical, "https://tulsaurbanist.org/" %>
<% content_for :og_image, "https://tulsaurbanist.org/og/tulsa-urbanist-map.png" %>

<% content_for :json_ld do %>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Tulsa Urbanist",
  "url": "https://tulsaurbanist.org/",
  "description": "An open map of Tulsa's traffic fatalities, surface parking, and citizen street redesigns.",
  "potentialAction": {
    "@type": "SearchAction",
    "target": "https://tulsaurbanist.org/search?q={query}",
    "query-input": "required name=query"
  },
  "about": { "@type": "Place", "name": "Tulsa, Oklahoma", "geo": { "@type": "GeoCoordinates", "latitude": 36.154, "longitude": -95.993 } }
}
</script>
<% end %>

<div style="font-family:'Merriweather Sans',sans-serif; color:#f7f2e3; background:#0d1830;">

  <header style="position:sticky; top:0; z-index:50; display:flex; align-items:center; justify-content:space-between; padding:14px 40px; background:rgba(13,24,48,0.92); backdrop-filter:blur(10px); border-bottom:1px solid rgba(226,177,66,0.4);">
    <%= link_to "Tulsa Urbanist", "/", style: "font-family:'Bowlby One',sans-serif; font-size:22px; line-height:1; background-image:url('/tulsa-flag.png'); background-size:cover; background-position:center; -webkit-background-clip:text; background-clip:text; color:transparent;" %>
    <nav style="display:flex; align-items:center; gap:26px; font-family:'Montserrat',sans-serif; font-size:13px; font-weight:600; letter-spacing:0.4px;">
      <%= link_to "The Map", "/map", style: "color:#f7f2e3;" %>
      <%= link_to "Fatalities", incidents_path, style: "color:#f7f2e3;" %>
      <%= link_to "Parking", "/parking", style: "color:#f7f2e3;" %>
      <%= link_to "Redesigns", "/redesigns", style: "color:#f7f2e3;" %>
      <%= link_to "Open the map", "/map", style: "background:#e2b142; color:#0d1830; padding:9px 18px; border-radius:2px;" %>
    </nav>
  </header>

  <section style="position:relative; height:660px; overflow:hidden;">
    <svg width="100%" height="100%" viewBox="0 0 1280 660" preserveAspectRatio="xMidYMid slice" style="position:absolute; inset:0; display:block;">
      <defs>
        <pattern id="gridH" width="48" height="48" patternUnits="userSpaceOnUse"><path d="M48 0H0V48" fill="none" stroke="rgba(247,242,227,0.06)" stroke-width="1"></path></pattern>
      </defs>
      <rect width="1280" height="660" fill="#0d1830"></rect>
      <rect width="1280" height="660" fill="url(#gridH)"></rect>
      <path d="M -60 120 C 150 240, 230 380, 150 540 C 110 620, 30 700, -60 760" fill="none" stroke="rgba(157,196,181,0.16)" stroke-width="86" stroke-linecap="round"></path>
      <g stroke="rgba(247,242,227,0.14)" stroke-width="3">
        <line x1="0" y1="200" x2="1280" y2="200"></line>
        <line x1="0" y1="440" x2="1280" y2="440"></line>
        <line x1="380" y1="0" x2="380" y2="660"></line>
        <line x1="760" y1="0" x2="760" y2="660"></line>
        <line x1="1040" y1="0" x2="1040" y2="660"></line>
      </g>
      <rect x="380" y="200" width="380" height="240" fill="rgba(247,242,227,0.03)"></rect>
      <g fill="rgba(91,103,124,0.5)" stroke="rgba(247,242,227,0.2)" stroke-width="1" stroke-dasharray="4 3">
        <rect x="410" y="232" width="70" height="52"></rect><rect x="505" y="220" width="58" height="74"></rect><rect x="440" y="318" width="84" height="56"></rect><rect x="558" y="300" width="66" height="66"></rect><rect x="480" y="392" width="96" height="40"></rect><rect x="642" y="244" width="60" height="60"></rect>
      </g>
      <g>
        <rect x="820" y="246" width="44" height="38" fill="#e2b142"></rect><rect x="872" y="246" width="34" height="38" fill="#e2b142"></rect><rect x="820" y="292" width="38" height="42" fill="#e2b142"></rect><rect x="866" y="292" width="40" height="42" fill="#e2b142"></rect><rect x="920" y="246" width="54" height="88" fill="rgba(157,196,181,0.6)"></rect>
      </g>
      <g fill="#b73032">
        <circle cx="380" cy="200" r="5"></circle><circle cx="500" cy="200" r="5"></circle><circle cx="540" cy="300" r="5"></circle><circle cx="640" cy="200" r="5"></circle><circle cx="760" cy="300" r="5"></circle><circle cx="420" cy="440" r="5"></circle><circle cx="600" cy="440" r="5"></circle><circle cx="1040" cy="320" r="5"></circle><circle cx="980" cy="500" r="5"></circle>
      </g>
    </svg>

    <div style="position:absolute; left:40px; bottom:44px; max-width:820px;">
      <div style="font-family:'Montserrat',sans-serif; font-size:12px; font-weight:700; letter-spacing:2.5px; color:#9dc4b5; text-transform:uppercase; margin-bottom:14px;">Tulsa, Oklahoma &middot; open civic map</div>
      <h1 style="font-family:'Bowlby One',sans-serif; font-size:58px; line-height:0.98; color:#f7f2e3; margin:0; text-wrap:balance;">We don't ask <span style="color:#e2b142;">enough</span> of our land.</h1>
      <p style="font-size:18px; line-height:1.55; color:rgba(247,242,227,0.85); margin:20px 0 0; max-width:640px;">A surface parking lot is barely an improvement on a vacant one &mdash; both return almost nothing per acre. Tulsa Urbanist maps what every acre of the city gives back today, and what it could give instead.</p>
      <div style="display:flex; gap:14px; margin-top:26px; font-family:'Montserrat',sans-serif; font-weight:600; font-size:14px;">
        <%= link_to "Open the live map", "/map", style: "background:#e2b142; color:#0d1830; padding:13px 26px; border-radius:2px;" %>
        <%= link_to "See documented fatalities", incidents_path, style: "background:transparent; color:#f7f2e3; padding:13px 26px; border-radius:2px; border:1px solid rgba(247,242,227,0.4);" %>
      </div>
    </div>
  </section>

  <section style="padding:84px 40px; background:#152645;">
    <div style="max-width:1180px; margin:0 auto;">
      <h2 style="font-family:'Bowlby One',sans-serif; font-size:38px; line-height:1; color:#f7f2e3; margin:0 0 16px;">The case, in three lenses.</h2>
      <p style="font-size:17px; line-height:1.6; color:rgba(247,242,227,0.75); max-width:680px; margin:0 0 48px;">Each lens is a layer on the map. Together they ask one question &mdash; how much value do we get from each acre, and how much are we leaving on the table?</p>
      <div style="display:grid; grid-template-columns:repeat(3,1fr); gap:24px;">
        <article style="background:#0d1830; border-top:4px solid #b73032; padding:30px 28px;">
          <h3 style="font-family:'Montserrat',sans-serif; font-size:19px; font-weight:700; color:#f7f2e3; margin:0 0 10px;">People killed on Tulsa streets</h3>
          <p style="font-size:15px; line-height:1.6; color:rgba(247,242,227,0.72); margin:0 0 18px;">Every red marker is a documented traffic fatality, geocoded to the street where it happened. The clusters aren't random &mdash; they trace the roads we built for speed.</p>
          <%= link_to "Explore the fatalities data →", incidents_path, style: "font-family:'Montserrat',sans-serif; font-size:13px; font-weight:700; color:#9dc4b5; letter-spacing:0.5px;" %>
        </article>
        <article style="background:#0d1830; border-top:4px solid #5b677c; padding:30px 28px;">
          <h3 style="font-family:'Montserrat',sans-serif; font-size:19px; font-weight:700; color:#f7f2e3; margin:0 0 10px;">Acres downtown that earn almost nothing</h3>
          <p style="font-size:15px; line-height:1.6; color:rgba(247,242,227,0.72); margin:0 0 18px;">Per acre, a surface lot returns about as little as the vacant land it replaced &mdash; almost no tax, no homes, no street life.</p>
          <%= link_to "Map the parking craters →", "/parking", style: "font-family:'Montserrat',sans-serif; font-size:13px; font-weight:700; color:#9dc4b5; letter-spacing:0.5px;" %>
        </article>
        <article style="background:#0d1830; border-top:4px solid #e2b142; padding:30px 28px;">
          <h3 style="font-family:'Montserrat',sans-serif; font-size:19px; font-weight:700; color:#f7f2e3; margin:0 0 10px;">Citizen redesigns</h3>
          <p style="font-size:15px; line-height:1.6; color:rgba(247,242,227,0.72); margin:0 0 18px;">Anyone can drop buildings, parks, and narrower streets onto the same map &mdash; and show how much more a block could return.</p>
          <%= link_to "Browse the redesigns →", "/redesigns", style: "font-family:'Montserrat',sans-serif; font-size:13px; font-weight:700; color:#9dc4b5; letter-spacing:0.5px;" %>
        </article>
      </div>
    </div>
  </section>

  <section style="padding:84px 40px; background:#f7f2e3; color:#152645;">
    <div style="max-width:1180px; margin:0 auto;">
      <div style="font-family:'Montserrat',sans-serif; font-size:12px; font-weight:700; letter-spacing:2.5px; color:#b73032; text-transform:uppercase; margin-bottom:14px;">The measure</div>
      <h2 style="font-family:'Bowlby One',sans-serif; font-size:38px; line-height:1; color:#152645; margin:0 0 16px; max-width:760px;">Value per acre, not per parcel.</h2>
      <p style="font-size:17px; line-height:1.65; color:#4a4a4a; max-width:720px; margin:0 0 44px;">We judge land by the parcel &mdash; and that flatters whatever is biggest and cheapest to build: the big-box store, the strip mall, the parking lot. Measure the same ground <em>by the acre</em> and the order can flip entirely. This is the lens we're building Tulsa Urbanist around, once real assessor data is in place.</p>
    </div>
  </section>

  <section style="padding:84px 40px; background:#9dc4b5;">
    <div style="max-width:1180px; margin:0 auto;">
      <div style="font-family:'Montserrat',sans-serif; font-size:12px; font-weight:700; letter-spacing:2.5px; color:#152645; text-transform:uppercase; margin-bottom:14px;">What it could be</div>
      <h2 style="font-family:'Bowlby One',sans-serif; font-size:38px; line-height:1; color:#152645; margin:0 0 40px;">The same ground, reimagined.</h2>
      <div style="display:grid; grid-template-columns:1fr 1fr; gap:24px;">
        <%= link_to "/redesigns/reconnecting-greenwood", style: "display:block; background:#f7f2e3; padding:30px 28px; border-radius:2px;" do %>
          <h3 style="font-family:'Montserrat',sans-serif; font-size:22px; font-weight:700; color:#152645; margin:0 0 10px;">Reconnecting Greenwood</h3>
          <p style="font-size:15px; line-height:1.6; color:#4a4a4a; margin:0 0 16px;">Capping the highway trench that severed the historic district, restoring the street grid and the blocks it erased.</p>
          <span style="font-family:ui-monospace,Menlo,monospace; font-size:12px; color:#5b677c;">/redesigns/reconnecting-greenwood</span>
        <% end %>
        <%= link_to "/redesigns/downtown-parking-to-housing", style: "display:block; background:#f7f2e3; padding:30px 28px; border-radius:2px;" do %>
          <h3 style="font-family:'Montserrat',sans-serif; font-size:22px; font-weight:700; color:#152645; margin:0 0 10px;">From parking lot to neighborhood</h3>
          <p style="font-size:15px; line-height:1.6; color:#4a4a4a; margin:0 0 16px;">A four-block surface lot replaced with mid-rise homes, a pocket park, and a street people can cross.</p>
          <span style="font-family:ui-monospace,Menlo,monospace; font-size:12px; color:#5b677c;">/redesigns/downtown-parking-to-housing</span>
        <% end %>
      </div>
    </div>
  </section>

  <footer style="padding:64px 40px 48px; background:#0d1830; border-top:1px solid rgba(226,177,66,0.4);">
    <div style="max-width:1180px; margin:0 auto;">
      <div style="display:grid; grid-template-columns:1.4fr 1fr 1fr 1fr; gap:32px; padding-bottom:40px; border-bottom:1px solid rgba(247,242,227,0.12);">
        <div>
          <%= link_to "Tulsa Urbanist", "/", style: "font-family:'Bowlby One',sans-serif; font-size:24px; background-image:url('/tulsa-flag.png'); background-size:cover; background-position:center; -webkit-background-clip:text; background-clip:text; color:transparent;" %>
          <p style="font-size:14px; line-height:1.6; color:rgba(247,242,227,0.6); margin:14px 0 0; max-width:300px;">An open, citizen-run map of how Tulsa's streets serve cars &mdash; and how they could serve people.</p>
        </div>
        <nav style="font-family:'Montserrat',sans-serif; font-size:14px;">
          <div style="font-weight:700; color:#9dc4b5; letter-spacing:1px; margin-bottom:14px; font-size:12px;">EXPLORE</div>
          <div style="display:flex; flex-direction:column; gap:10px;"><%= link_to "The live map", "/map", style: "color:rgba(247,242,227,0.8);" %><%= link_to "Fatalities", incidents_path, style: "color:rgba(247,242,227,0.8);" %><%= link_to "Surface parking", "/parking", style: "color:rgba(247,242,227,0.8);" %><%= link_to "Redesigns", "/redesigns", style: "color:rgba(247,242,227,0.8);" %></div>
        </nav>
        <nav style="font-family:'Montserrat',sans-serif; font-size:14px;">
          <div style="font-weight:700; color:#9dc4b5; letter-spacing:1px; margin-bottom:14px; font-size:12px;">DATA</div>
          <div style="display:flex; flex-direction:column; gap:10px;"><%= link_to "Methodology", "/data", style: "color:rgba(247,242,227,0.8);" %><%= link_to "Open GeoJSON API", "/api/v1/incidents/geojson", style: "color:rgba(247,242,227,0.8);" %><%= link_to "Sitemap", "/sitemap.xml", style: "color:rgba(247,242,227,0.8);" %></div>
        </nav>
        <nav style="font-family:'Montserrat',sans-serif; font-size:14px;">
          <div style="font-weight:700; color:#9dc4b5; letter-spacing:1px; margin-bottom:14px; font-size:12px;">CONTRIBUTE</div>
          <div style="display:flex; flex-direction:column; gap:10px;"><%= link_to "Report an incident", "/incidents/quick_new", style: "color:rgba(247,242,227,0.8);" %><%= link_to "Draw a redesign", "/redesigns/new", style: "color:rgba(247,242,227,0.8);" %><%= link_to "Edit parking map", "/parking", style: "color:rgba(247,242,227,0.8);" %><%= link_to "About the project", "/about", style: "color:rgba(247,242,227,0.8);" %></div>
        </nav>
      </div>
      <div style="font-family:'Montserrat',sans-serif; font-size:12px; color:rgba(247,242,227,0.45); margin-top:24px;">&copy; <%= Date.current.year %> Tulsa Urbanist &middot; Tulsa, Oklahoma &middot; An art &amp; advocacy project. Data is community-sourced and verified.</div>
    </div>
  </footer>

</div>
