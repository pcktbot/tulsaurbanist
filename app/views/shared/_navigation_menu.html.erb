<div class="primary-nav-col">
  <div class="flex align-center">
    <strong class="text-quaternary">Parking</strong>
    <%= link_to 'Map', parking_path, class: 'nav-link' %>
    <% if user_signed_in? %>
      <%= link_to 'Edit', parking_edit_path, class: 'nav-link' %>
    <% end %>
  </div>
  <div class="flex align-center">
    <strong class="text-quaternary">Traffic Incidents</strong>
    <%= link_to 'Table', incidents_path, class: 'nav-link' %> 
    <%= link_to 'Map', map_incidents_path, class: 'nav-link' %>
  </div>
  <div class="flex align-center">
    <% if user_signed_in? %>
      <strong class="text-quaternary">Logged in: <%= current_user.username %></strong>
      <%= link_to "My Redesigns", redesigns_path, class: 'nav-link' %>
      <%= button_to "Logout", destroy_user_session_path, method: :delete, class: 'nav-link' %>
    <% else %>
      <%= link_to "Login", new_user_session_path, class: 'nav-link' %>
      <%= link_to "Sign up", new_user_registration_path, class: 'nav-link' %>
    <% end %>
  </div>
</div>
