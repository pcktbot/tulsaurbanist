<div class="form-container" data-controller="form-pane">
  <div class="form-placeholder">
    <div class="placeholder-icon">📝</div>
    <h3>Incident Form</h3>
    <p>Quick entry or edit form will load here</p>
    <% if user_authenticated? %>
      <div class="placeholder-actions">
        <%= link_to 'Quick Entry', quick_new_incidents_path, class: 'btn btn-primary', data: { turbo_frame: 'form-content' } %>
      </div>
    <% else %>
      <p><%= link_to 'Login', new_user_session_path, class: 'link' %> to create incidents</p>
    <% end %>
  </div>
</div>
