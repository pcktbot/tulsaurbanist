<header class="header px-2 flex align-stretch justify-between">
  <a class="home-link" href="/">TulsaUrbanist</a>
  <div class="links flex justify-evenly align-center">
    <%= yield %>
    <% if user_authenticated? %>
      <%= link_to 'Sign Out', destroy_user_session_path, method: :delete, class: 'link' %>
    <% else %>
      <%= link_to 'Login', new_user_session_path, class: 'link login-link' %>
    <% end %>
  </div>
</header>