<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>https://tulsaurbanist.org/</loc>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>https://tulsaurbanist.org/map</loc>
    <changefreq>daily</changefreq>
    <priority>0.9</priority>
  </url>
  <url>
    <loc>https://tulsaurbanist.org/corridors</loc>
    <changefreq>weekly</changefreq>
    <priority>0.8</priority>
  </url>
  <% @corridors.each do |corridor| %>
  <url>
    <loc>https://tulsaurbanist.org/corridors/<%= corridor[:slug] %></loc>
    <changefreq>monthly</changefreq>
    <priority>0.7</priority>
  </url>
  <% end %>
  <url>
    <loc>https://tulsaurbanist.org/incidents</loc>
    <changefreq>daily</changefreq>
    <priority>0.7</priority>
  </url>
  <% @incidents.each do |incident| %>
  <url>
    <loc>https://tulsaurbanist.org/incidents/<%= incident.id %></loc>
    <lastmod><%= incident.updated_at.strftime("%Y-%m-%d") %></lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.5</priority>
  </url>
  <% end %>
  <url>
    <loc>https://tulsaurbanist.org/redesigns</loc>
    <changefreq>weekly</changefreq>
    <priority>0.6</priority>
  </url>
  <% @redesigns.each do |redesign| %>
  <url>
    <loc>https://tulsaurbanist.org/redesigns/<%= redesign.id %></loc>
    <lastmod><%= redesign.updated_at.strftime("%Y-%m-%d") %></lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.5</priority>
  </url>
  <% end %>
  <url>
    <loc>https://tulsaurbanist.org/parking</loc>
    <changefreq>weekly</changefreq>
    <priority>0.6</priority>
  </url>
</urlset>
